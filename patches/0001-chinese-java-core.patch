+    /**
+     * ChineseJava：诊断前缀默认走**英文**，以保住工具链解析
+     * （编辑器问题面板 / 构建工具 / CI 日志解析都认 error: / warning: / note:）。
+     * 设系统属性 -Dchinesejava.diagnostics.prefix=zh（或环境变量 CHINESEJAVA_PREFIX=zh）
+     * 时改用中文前缀（错误: / 警告: / 注:）。
+     */
+    private String formatKindPrefix(Locale l, String englishKey, String chineseKey) {
+        String pref = System.getProperty("chinesejava.diagnostics.prefix");
+        if (pref == null) {
+            pref = System.getenv("CHINESEJAVA_PREFIX");
+        }
+        if (pref != null && pref.equalsIgnoreCase("zh")) {
+            String zh = zhPrefix(chineseKey);
+            if (zh != null && !zh.isEmpty()) {
+                return zh;
+            }
+        }
+        return localize(l, englishKey);
+    }
